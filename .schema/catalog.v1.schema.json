{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/controlplane-com/templates/blob/main/.schema/catalog.v1.schema.json",
  "title": "Template catalog entry (catalog.yaml)",
  "description": "Search metadata for one template, describing its latest version. Read CATALOG_AUTHORING.md before writing one.",
  "type": "object",
  "required": ["apiVersion", "kind"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "catalog.controlplane.com/v1" },
    "kind": { "const": "TemplateCatalogEntry" },
    "internal": {
      "type": "boolean",
      "description": "true keeps the template out of search; then only apiVersion and kind are required and every other field is ignored."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "The product name as people write it; a variant names its difference in parentheses."
    },
    "category": {
      "enum": [
        "database",
        "cache",
        "messaging",
        "search",
        "storage",
        "analytics",
        "observability",
        "ai",
        "identity",
        "secrets",
        "security",
        "networking",
        "workflow",
        "developer-tools",
        "apps"
      ],
      "description": "The one category a person would browse to find it; the only category the catalog shows."
    },
    "topology": {
      "enum": ["multi-location", "distributed", "highly-available", "single", "stateless"],
      "description": "How the main component runs; take the first value that applies, in this order."
    },
    "family": {
      "$ref": "#/$defs/templateName",
      "description": "The default member of the family of templates that deploy the same software in different topologies. Defaults to this template's name."
    },
    "summary": {
      "type": "string",
      "minLength": 100,
      "maxLength": 600,
      "description": "Two to four sentences: what it deploys, the options, and when it is the right pick."
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 25,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^A-Z]+$" },
      "description": "Lowercase search terms not already in the title. Nothing the template can't do."
    },
    "useCases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "description": "Problems it solves, phrased the way a user states them."
    },
    "alternativeTo": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 },
      "description": "External products and managed services this template can replace. Never a template from this repo."
    },
    "compatibleWith": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "postgres-wire",
          "mysql-wire",
          "mongodb-wire",
          "redis-protocol",
          "cql",
          "kafka-api",
          "amqp",
          "mqtt",
          "nats",
          "s3-api",
          "openai-api",
          "otlp",
          "prometheus-remote-write",
          "promql",
          "elasticsearch-api",
          "oidc",
          "saml",
          "ldap",
          "smtp",
          "iceberg-rest",
          "sftp",
          "ftp",
          "webdav"
        ]
      },
      "description": "APIs and wire protocols the template's service speaks, so existing clients work unchanged."
    },
    "pickInsteadIf": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "template"],
        "properties": {
          "need": { "type": "string", "minLength": 1, "maxLength": 120 },
          "template": { "$ref": "#/$defs/templateName" }
        }
      },
      "description": "Needs this template does not meet, each with the template in this repo that meets it."
    },
    "related": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "relation"],
        "properties": {
          "template": { "$ref": "#/$defs/templateName" },
          "relation": { "enum": ["companion", "alternative"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "description": "Templates often installed alongside this one, or that solve the same problem without one deciding need. Never bundled subcharts."
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" },
      "description": "Everything the user creates before installing, plus what optional features need. [] when the default install needs nothing."
    }
  },
  "if": { "required": ["internal"], "properties": { "internal": { "const": true } } },
  "else": { "required": ["title", "category", "topology", "summary", "keywords", "useCases", "prerequisites"] },
  "$defs": {
    "templateName": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "valuesPath": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$" },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "required"],
      "properties": {
        "kind": { "enum": ["secret", "cloud-account", "bucket", "domain", "other"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "required": { "type": "boolean" },
        "when": { "type": "string", "minLength": 1, "maxLength": 160 },
        "valuesPath": {
          "oneOf": [
            { "$ref": "#/$defs/valuesPath" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/valuesPath" } }
          ]
        },
        "secretType": {
          "enum": [
            "opaque",
            "dictionary",
            "tls",
            "userpass",
            "keypair",
            "aws",
            "ecr",
            "gcp",
            "azure-sdk",
            "azure-connector",
            "docker",
            "nats-account"
          ]
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        }
      },
      "allOf": [
        { "if": { "required": ["required"], "properties": { "required": { "const": false } } }, "then": { "required": ["when"] } },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "secret" } } },
          "then": { "required": ["secretType"] },
          "else": { "not": { "anyOf": [{ "required": ["secretType"] }, { "required": ["keys"] }] } }
        },
        {
          "if": { "required": ["secretType"], "properties": { "secretType": { "const": "dictionary" } } },
          "then": { "required": ["keys"] }
        }
      ]
    }
  }
}
